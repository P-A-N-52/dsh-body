{
  "schemaVersion": 1,
  "actions": [
    {
      "type": "drink",
      "target": "stomach",
      "payload": {
        "volumeMl": { "type": "number", "unit": "mL", "min": 0, "max": 2000, "required": true },
        "durationMin": { "type": "number", "unit": "min", "min": 0, "max": 60, "default": 0 }
      }
    },
    {
      "type": "eat",
      "target": "stomach",
      "payload": {
        "volumeMl": { "type": "number", "unit": "mL", "min": 0, "max": 3000, "required": true },
        "energyKcal": { "type": "number", "unit": "kcal", "min": 0, "max": 5000, "required": true },
        "mealKind": { "type": "string", "enum": ["liquid", "solid", "mixed"], "required": true },
        "durationMin": { "type": "number", "unit": "min", "min": 0, "max": 120, "default": 0 },
        "composition": {
          "type": "object",
          "required": false,
          "properties": {
            "carbG": { "type": "number", "unit": "g", "min": 0 },
            "fatG": { "type": "number", "unit": "g", "min": 0 },
            "proteinG": { "type": "number", "unit": "g", "min": 0 }
          }
        }
      }
    }
  ]
}
