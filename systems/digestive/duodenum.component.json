{
  "schemaVersion": 1,
  "id": "duodenum",
  "system": "digestive",
  "kind": "organ",
  "implementation": "ready",
  "module": "./duodenum.ts",
  "version": 1,
  "model": {
    "nutrientExposure": "firstOrder"
  },
  "signals": {
    "duodenum.nutrientExposure": {
      "unit": "kcal/min",
      "range": [0, null],
      "kind": "state",
      "commit": "roundEnd",
      "description": "到达小肠的营养暴露代理；不是吸收量"
    }
  },
  "reads": ["stomach.emptiedKcal"],
  "writes": ["duodenum.nutrientExposure"],
  "parameters": "./duodenum.parameters.json",
  "state": {
    "nutrientExposure": { "type": "number", "unit": "kcal/min", "min": 0, "initial": 0, "visibility": "public" }
  },
  "resetOnStart": []
}
