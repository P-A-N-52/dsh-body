{
  "schemaVersion": 1,
  "id": "ghrelin",
  "system": "endocrine",
  "kind": "hormone",
  "implementation": "planned",
  "module": "./ghrelin.ts",
  "version": 1,
  "model": {
    "relativeConcentration": "mealResponse"
  },
  "signals": {
    "ghrelin.relativeConcentration": {
      "unit": "1",
      "range": [0, null],
      "kind": "state",
      "commit": "roundEnd",
      "description": "相对空腹基线，不是绝对浓度"
    }
  },
  "reads": ["stomach.lastIntakeAt"],
  "writes": ["ghrelin.relativeConcentration"],
  "parameters": "./ghrelin.parameters.json",
  "state": {
    "relativeConcentration": { "type": "number", "unit": "1", "min": 0, "initial": 1, "visibility": "public" }
  },
  "resetOnStart": []
}
